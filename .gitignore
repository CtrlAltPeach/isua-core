# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# временные файлы рабочего процесса (сообщения коммитов, verify-скрипты)
commit-msg-tmp.txt
verify*-tmp.mjs
dev-server.log

# дампы/бэкапы БД — содержат данные (в т.ч. зашифрованные ПДн), НЕ коммитить
*.dump
*.sql
!prisma/migrations/**/*.sql
/backups/
/scripts/
