# Скопируйте в .env и заполните значениями.

# База данных
# Разработка (PostgreSQL):
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/isua?schema=public"

# JWT (HS256)
JWT_SECRET="replace-with-long-random-string"
JWT_EXPIRY="24h"

# Шифрование персональных данных (AES-256-GCM): паспорт, ИНН, СНИЛС.
# 32 байта (256 бит) в hex. Сгенерировать:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="replace-with-32-byte-hex-key"

# Логирование
LOG_LEVEL="info"
