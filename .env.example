# Скопируйте в .env и заполните значениями.
#
# ВАЖНО про деплой (Vercel и т.п.):
#   Файл .env НЕ читается на хостинге — переменные задаются в настройках проекта
#   (Vercel: Settings -> Environment Variables, среда Production/Preview/Development),
#   ЗНАЧЕНИЕ без кавычек, имя переменной — точь-в-точь как здесь. После добавления —
#   обязательно Redeploy (переменные применяются только к новым деплоям).

# База данных
# Разработка (локальный PostgreSQL):
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/isua?schema=public"

# JWT (HS256) — секрет подписи токенов. ДЛЯ ПРОДА сгенерировать СВОЙ длинный случайный:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-long-random-string"
JWT_EXPIRY="24h"

# Шифрование персональных данных (AES-256-GCM): паспорт, ИНН, СНИЛС.
# 32 байта (256 бит) в hex (64 hex-символа). Сгенерировать:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ⚠️ При СМЕНЕ ключа все ранее зашифрованные ПДн становятся НЕЧИТАЕМЫМИ —
#    храните его как пароль от БД, бэкапьте отдельно, не меняйте на проде с данными.
ENCRYPTION_KEY="replace-with-32-byte-hex-key"

# Rate-limit: доверять заголовку X-Forwarded-For (H1).
# На Vercel НЕ нужно (там доверенный x-vercel-forwarded-for). Ставить "1"
# ТОЛЬКО если приложение за известным reverse-proxy (nginx/Caddy), который
# сам проставляет XFF. Иначе клиент сможет подделать IP и обойти лимит.
# TRUST_PROXY="1"

# Сидинг ОТКЛЮЧЁН по умолчанию (данные заводятся вручную). Чтобы засеять
# тестовые данные (4 программы + демо-админ + 60 абитуриентов): SEED_DATA=1.
# SEED_DATA="1"

# Пароль демо-админа при сидинге (если SEED_DATA=1). Без переменной — admin12345 (dev).
# SEED_ADMIN_PASSWORD="..."

# Логирование
LOG_LEVEL="info"
