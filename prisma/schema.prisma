// Prisma schema для ИСУА — Информационная система учёта абитуриентов.
// Документация: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Статусы абитуриента.
// applied  — подал заявление (рабочий статус)
// withdrawn — забрал заявление (красный, согласие авто-снимается)
enum ApplicantStatus {
  applied
  withdrawn
}

// Тип документа об образовании.
enum DocumentType {
  diploma // диплом
  certificate // аттестат
}

// Образовательная программа (5 программ: ИСД, ТГСВ, ЗиК, ЗиК-КИ, ЗиК-ГК).
model Program {
  id         Int         @id @default(autoincrement())
  name       String      @unique
  places     Int // количество бюджетных мест
  // Минимальные баллы по предметам, напр. {"russian":36,"mathProfile":27,...}.
  // null/отсутствие ключа = порог не задан.
  minScores  Json?
  applicants Applicant[]
  createdAt  DateTime    @default(now())
}

// Роль пользователя.
// admin    — управление юзерами/программами, удаление (доступ к /manage)
// operator — работа с абитуриентами (CRUD), без /manage и создания юзеров
enum Role {
  admin
  operator
}

// Пользователь системы (оператор приёмной комиссии).
model User {
  id           Int         @id @default(autoincrement())
  email        String      @unique
  passwordHash String // bcrypt-хеш, никогда не возвращается в API
  username     String      @unique
  role         Role        @default(operator)
  createdAt    DateTime    @default(now())
  lastLogin    DateTime?
  applicants   Applicant[] @relation("CreatedBy")
  histories    History[]   @relation("ChangedBy")
}

// Абитуриент.
model Applicant {
  id        Int             @id @default(autoincrement())
  fullName  String
  phone     String?
  email     String?
  programId Int
  program   Program         @relation(fields: [programId], references: [id])
  status    ApplicantStatus @default(applied)

  consentToEnroll   Boolean @default(false) // согласие на зачисление
  documentsComplete Boolean @default(false)
  specialQuota      Boolean @default(false) // особая квота
  specialRight      Boolean @default(false) // особое право
  isPaid            Boolean @default(false) // платное обучение

  // Документ об образовании и гражданство
  documentType DocumentType? // диплом | аттестат
  citizenship  String? // гражданство (Россия, Беларусь, …)
  passportSeries String? // серия паспорта
  passportNumber String? // номер паспорта

  // Результаты экзаменов
  mathBase    Int? // оценка 2-5, в рейтинг НЕ входит (взаимоисключающа с mathProfile)
  mathProfile Float? // 0-100
  russian     Float?
  chemistry   Float?
  physics     Float?
  informatics Float?
  geography   Float?
  additionalScores Float @default(0) // доп. баллы / ВИ (могут поднять total выше 300)
  totalScore  Float? // авто: сумма топ-3 предметов (без mathBase) + additionalScores

  // Персональные данные
  registrationAddress String?
  inn                 String?
  snils               String?
  notes               String?

  // Оптимистичная блокировка
  version Int @default(1)

  // Служебные поля
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdByUserId Int
  createdBy       User     @relation("CreatedBy", fields: [createdByUserId], references: [id])

  history History[]
  lock    Lock?

  @@index([programId])
  @@index([status])
  @@index([totalScore])
  @@index([createdAt])
}

// Журнал изменений: field | old | new | who | when.
model History {
  id              Int       @id @default(autoincrement())
  applicantId     Int
  applicant       Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  fieldName       String
  oldValue        String?
  newValue        String?
  changedByUserId Int
  changedBy       User      @relation("ChangedBy", fields: [changedByUserId], references: [id])
  changedAt       DateTime  @default(now())

  @@index([applicantId])
  @@index([changedAt])
}

// Блокировка записи для совместного редактирования (heartbeat + таймаут).
model Lock {
  id               Int       @id @default(autoincrement())
  applicantId      Int       @unique
  applicant        Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  userSessionId    String // идентификатор сессии-владельца
  lockedByUsername String // имя владельца (для отображения «Редактирует: …»)
  lockedAt         DateTime  @default(now())
  lastHeartbeat    DateTime  @default(now())
}
