// Prisma schema для ИСУА — Информационная система учёта абитуриентов.
// Документация: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Статусы абитуриента.
// applied  — подал заявление (рабочий статус)
// withdrawn — забрал заявление (красный, согласие авто-снимается)
enum ApplicantStatus {
  applied
  withdrawn
}

// Тип документа об образовании.
enum DocumentType {
  diploma // диплом
  certificate // аттестат
}

// Вид экзамена: егэ — по предметам ЕГЭ; vi — по вступит. испытаниям вуза (ВИ).
// examType=vi: балл total считается по viScore/предметам ВИ, ЕГЭ игнорируется.
enum ExamType {
  ege
  vi
}

// Группа (категория) программ — для группировки в статистике и отчётах.
// Программы без группы показываются блоком «Без группы».
model ProgramGroup {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  sortOrder Int       @default(0) // порядок вывода групп
  programs  Program[]
  createdAt DateTime  @default(now())
}

// Образовательная программа (5 программ: ИСД, ТГСВ, ЗиК, ЗиК-КИ, ЗиК-ГК).
model Program {
  id         Int         @id @default(autoincrement())
  name       String      @unique
  places     Int // количество бюджетных мест
  // Минимальные баллы по предметам, напр. {"russian":36,"mathProfile":27,...}.
  // null/отсутствие ключа = порог не задан.
  minScores  Json?
  // Группа программ (опционально). Удаление группы → SetNull (программа остаётся).
  programGroupId Int?
  programGroup   ProgramGroup? @relation(fields: [programGroupId], references: [id], onDelete: SetNull)
  applicants Applicant[]
  createdAt  DateTime    @default(now())

  @@index([programGroupId])
}

// Роль пользователя.
// admin    — управление юзерами/программами, удаление (доступ к /manage)
// operator — работа с абитуриентами (CRUD), без /manage и создания юзеров
enum Role {
  admin
  operator
}

// Пользователь системы (оператор приёмной комиссии).
model User {
  id           Int         @id @default(autoincrement())
  email        String      @unique
  passwordHash String // bcrypt-хеш, никогда не возвращается в API
  username     String      @unique
  role         Role        @default(operator)
  // Версия токена: инкремент при logout/смене пароля отзывает все прежние JWT.
  tokenVersion Int         @default(0)
  createdAt    DateTime    @default(now())
  lastLogin    DateTime?
  applicants   Applicant[] @relation("CreatedBy")
  histories    History[]   @relation("ChangedBy")
}

// Абитуриент.
model Applicant {
  id        Int             @id @default(autoincrement())
  fullName  String
  phone     String?
  email     String?
  programId Int
  program   Program         @relation(fields: [programId], references: [id])
  status    ApplicantStatus @default(applied)

  consentToEnroll   Boolean @default(false) // согласие на зачисление
  documentsComplete Boolean @default(false)
  specialQuota      Boolean @default(false) // особая квота
  specialRight      Boolean @default(false) // особое право
  isPaid            Boolean @default(false) // платное обучение
  isDistant         Boolean @default(false) // дистанционное обучение

  // Вид экзамена: ege (по умолчанию) — предметы ЕГЭ; vi — вступит. испытания вуза.
  examType   ExamType @default(ege)

  // Дата рождения (только дата, без времени; хранится как DATE).
  birthDate DateTime? @db.Date

  // Документ об образовании и гражданство
  documentType DocumentType? // диплом | аттестат
  citizenship  String? // гражданство (Россия, Беларусь, …)
  passportSeries String? // серия паспорта
  passportNumber String? // номер паспорта

  // Результаты экзаменов. Баллы — целые (Int), валидация требует .int().
  // Предметы ЕГЭ (examType=ege): топ-3 + доп.баллы = total.
  mathBase    Int? // оценка 2-5, в рейтинг НЕ входит (взаимоисключающа с mathProfile)
  mathProfile Int? // 0-100
  russian     Int?
  chemistry   Int?
  physics     Int?
  informatics Int?
  geography   Int?
  additionalScores Int @default(0) // доп. баллы (индивидуальные достижения, 0-10)
  // ВИ — вступительные испытания вуза (для поступающих без ЕГЭ, examType=vi).
  // viScore — общий балл ВИ (0-300), при наличии заменяет топ-3 vi-предметов в total.
  viScore     Int?
  // Предметы ВИ (те же названия, что ЕГЭ). При examType=vi и отсутствии viScore —
  // total = сумма топ-3 vi-предметов + доп.баллы. ЕГЭ при этом игнорируется.
  viMathProfile Int?
  viRussian     Int?
  viChemistry   Int?
  viPhysics     Int?
  viInformatics Int?
  viGeography   Int?
  totalScore  Int? // авто: по examType (ВИ ?? viScore/топ-3 vi-предметов ИЛИ топ-3 ЕГЭ) + additionalScores

  // Персональные данные
  registrationAddress String?
  inn                 String?
  snils               String?
  notes               String?

  // Оптимистичная блокировка
  version Int @default(1)

  // Служебные поля
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdByUserId Int
  createdBy       User     @relation("CreatedBy", fields: [createdByUserId], references: [id])

  history History[]
  lock    Lock?

  @@index([programId])
  @@index([status])
  @@index([totalScore])
  @@index([createdAt])
}

// Журнал изменений: field | old | new | who | when.
model History {
  id              Int       @id @default(autoincrement())
  applicantId     Int
  applicant       Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  fieldName       String
  oldValue        String?
  newValue        String?
  changedByUserId Int
  changedBy       User      @relation("ChangedBy", fields: [changedByUserId], references: [id])
  changedAt       DateTime  @default(now())

  @@index([applicantId])
  @@index([changedAt])
}

// Блокировка записи для совместного редактирования (heartbeat + таймаут).
model Lock {
  id               Int       @id @default(autoincrement())
  applicantId      Int       @unique
  applicant        Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  userSessionId    String // идентификатор сессии-владельца
  lockedByUsername String // имя владельца (для отображения «Редактирует: …»)
  lockedAt         DateTime  @default(now())
  lastHeartbeat    DateTime  @default(now())
}
